{
  "name": "@firec/map-module",
  "version": "1.1.1",
  "description": "High-performance tile-based map engine with chunk loading, LOD rendering, and procedural generation support. Framework-agnostic and extensible.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "echo 'eslint not installed, skipping lint'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tilemap",
    "chunk",
    "2d",
    "canvas",
    "game-engine",
    "procedural-generation",
    "roguelike",
    "typescript"
  ],
  "author": "Firec",
  "license": "Beerware",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "sideEffects": false
}
